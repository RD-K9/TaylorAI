KONTEXT_GRADIO_SPACE=black-forest-labs/FLUX.1-Kontext-Dev
KONTEXT_GRADIO_API_NAME=/infer
KONTEXT_GRADIO_GUIDANCE=2.5
KONTEXT_GRADIO_STEPS=28
KONTEXT_GRADIO_TIMEOUT_SEC=180
HF_TOKEN=hf_xxxxx
# Try-on: bắt buộc HF_TOKEN thật (https://huggingface.co/settings/tokens)
